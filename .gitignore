# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# 打包与覆盖率产物
build/
dist/
*.egg-info/
.eggs/
.coverage
.coverage.*
htmlcov/
coverage.xml

# 虚拟环境
.venv/
venv/
env/
ENV/

# 本地环境变量与密钥，绝不能提交
.env
.env.*
!.env.example

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
# pytest 运行时在项目根目录留下的临时产物
pytest-of-*/
pytest-cache-files-*/
.pytest_tmp/

# 本地数据、模型与日志
data/
models/
.hf-cache/
*.log

# 前端依赖、构建产物与本地 npm 缓存
web/node_modules/
web/dist/
web/.npm-cache/

# IDE / 操作系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

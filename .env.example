# 复制为 .env 后可覆盖默认配置；不创建 .env 也能正常启动。
# PowerShell: Copy-Item .env.example .env

APP_NAME="科研知识库与实验助理 Agent"
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=20
DOCUMENTS_DIR=./data/documents
METADATA_DIR=./data/metadata
CHUNKS_DIR=./data/chunks
VECTOR_STORE_DIR=./data/vector_store
EMBEDDING_MODEL_PATH=./models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
MAX_RETRIEVAL_TEXT_LENGTH=1000

# 第四阶段：本地问答与证据过滤
QA_TOP_K=5
MIN_RETRIEVAL_SCORE=0.35
MIN_EVIDENCE_COUNT=1
MAX_CONTEXT_CHARS=6000
MAX_CITATION_TEXT_LENGTH=500

# 本地 OpenAI-compatible LLM，默认兼容 Ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# 第五阶段：LangGraph 问题改写与二次检索
ENABLE_QUERY_REWRITE=true
MAX_QUERY_REWRITE_ATTEMPTS=1
REWRITE_MAX_CHARS=500
AGENT_TOP_K=5
AGENT_MAX_CONTEXT_CHARS=6000
AGENT_TRACE_ENABLED=true

# 当前阶段不接入任何在线 API，因此不需要云端 API Key。
# 如本地服务需要鉴权，只能把 Key 写入本地 .env，禁止提交到版本库。

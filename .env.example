# 复制为 .env 后可覆盖默认配置；不创建 .env 也能正常启动。
# PowerShell: Copy-Item .env.example .env

APP_NAME="科研知识库与实验助理 Agent"
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=20
DOCUMENTS_DIR=./data/documents
METADATA_DIR=./data/metadata

# 当前阶段不接入任何外部 API，因此不需要 API Key。
# 后续阶段如需密钥，只能写入本地 .env，禁止提交到版本库。
